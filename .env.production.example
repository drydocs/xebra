# =============================================================================
# .env.production — MAINNET. REAL MONEY.
# =============================================================================
# Stellar mainnet -> Solana, Arc and the EVM chains the wrapper commits; Arc -> EVM chains and Solana. Every address below was read from the live
# chain (see packages/network-config/src/networks.ts for provenance) and is pinned:
# packages/network-config REFUSES to boot if any Circle contract address here is
# overridden, if any endpoint contains a testnet/devnet/sandbox/localhost marker, or if
# the network passphrase disagrees with NETWORK.
#
# NO SECRETS IN THIS FILE — it is committed. The deployed app's secrets, IRIS_BUDGET_SECRET and
# ADMIN_PASSWORD, are set in Vercel (and IRIS_BUDGET_SECRET on Convex too). On the self-hosted
# container path, private keys (SOLVER_SOLANA_KEYPAIR, SOLVER_STELLAR_SECRET), DATABASE_URL and
# API tokens are injected at runtime from AWS Secrets Manager. scripts/check-env-files.sh fails
# the build if a secret-shaped key appears here.
#
# Before pointing anything at this file:
#   1. scripts/check-cctp-interface.sh          (Circle can redeploy)
#   2. The wrapper is deployed and its id is filled in below
#   3. The bug-bounty period agreed as the launch gate has actually elapsed
# =============================================================================

NETWORK=mainnet

# --- Stellar (source chain, CCTP domain 27) ---------------------------------
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
HORIZON_URL=https://horizon.stellar.org
STELLAR_CCTP_DOMAIN_ID=27
# Circle CCTP V2 on Stellar mainnet. Verified live: paused()=false, 10M USDC/message cap,
# get_token_decimal_config -> {canonical:6, local:7}.
STELLAR_TOKEN_MESSENGER_ADDRESS=CAE2G5Z77UP7GYPYGFOWFGW7C7J6I4YP2AFGSADRKQY62SYUFLPNFTXL
STELLAR_MESSAGE_TRANSMITTER_ADDRESS=CACMENFFJPJMSDAJQLX4R7K3SFZIW2LJSE3R2UMLGSWHFHS353FVXAZV
# SAC derived from Circle's mainnet issuer GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN.
STELLAR_USDC_ADDRESS=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# --- Solana (destination chain, CCTP domain 5) ------------------------------
# A public RPC will rate-limit a busy deployment. Override SOLANA_RPC_URL with a paid
# endpoint — that override is permitted and is recorded in the startup log line.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CCTP_DOMAIN_ID=5
SOLANA_TOKEN_MESSENGER_ADDRESS=CCTPV2vPZJS2u2BBsUoscuikbYjnpFmbFsvVuJdgUMQe
SOLANA_MESSAGE_TRANSMITTER_ADDRESS=CCTPV2Sm4AdWt5296sk4P66VBZ7bEhcARwFaaS9YPbeC
SOLANA_USDC_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Arc (destination chain, CCTP domain 26) ---------------------------------
# Read from the chain, and re-checked by `pnpm check:arc`. Do not override the Circle contract
# addresses or the chain id — network-config refuses a mismatch. ARC_RPC_URL may be a paid
# endpoint. There is no Arc key: Circle's Forwarding Service mints on Arc, and a failed forward is
# claimed by its owner.
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CCTP_DOMAIN_ID=26
ARC_TOKEN_MESSENGER_ADDRESS=0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d
ARC_MESSAGE_TRANSMITTER_ADDRESS=0x81D40F21F12A8F0E3252Bccb954D722d4c464B64
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- Circle attestation service ---------------------------------------------
# Production deployment. A mainnet burn's attestation exists ONLY here.
IRIS_BASE_URL=https://iris-api.circle.com
# IRIS_BUDGET_SECRET guards the Convex counter that keeps our Iris calls under Circle's rate limit.
# It is a secret: set the same value on the Convex deployment and in the web app's server
# environment (`npx convex env set IRIS_BUDGET_SECRET ...`), never here.

# --- Xebra's own deployed contracts -----------------------------------------
# deployments/mainnet.json is the record (wrapper v2 is `cctpWrapperV2`); the web app reads
# NEXT_PUBLIC_STELLAR_CCTP_WRAPPER_CONTRACT_ID below. The escrow id and SOROBAN_START_LEDGER
# belong to the intent rail.
STELLAR_ESCROW_CONTRACT_ID=
SOROBAN_START_LEDGER=

# --- Arc escrow (corridor 1, the intent rail) ------------------------------
# ARC_RPC_URL and ARC_CHAIN_ID repeat the Arc section above. scripts/with-env.mjs skips empty
# values, so the ones above apply.
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_ESCROW_ADDRESS=

# --- Frontend (NEXT_PUBLIC_* are inlined at BUILD time, not runtime) --------
# Set them in Vercel before the build (or as Docker build args on the container path). Setting
# them at runtime is a no-op — Next.js has already inlined whatever was present at build time.
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
# Horizon returns plain JSON for transaction status, so confirmation polling
# needs no XDR decoding — see waitForTx in lib/cctp-bridge.ts.
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
NEXT_PUBLIC_STELLAR_USDC_SAC_ADDRESS=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# Circle's TokenMessengerMinter on Stellar; the same pinned address as above.
NEXT_PUBLIC_STELLAR_TOKEN_MESSENGER_ADDRESS=CAE2G5Z77UP7GYPYGFOWFGW7C7J6I4YP2AFGSADRKQY62SYUFLPNFTXL
NEXT_PUBLIC_SOLANA_CCTP_DOMAIN_ID=5
# Used (through /api/recipient and /api/solana-rpc) to look up the recipient's USDC token account
# before burning. receiveMessage never creates it; when it is missing, the transfer asks Circle's
# forwarder to (the 65-byte hook), and /claim creates it for a self-claim.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Offers Arc as a destination from Stellar when exactly `1`. Wrapper v2 has domain 26 committed,
# and production is built with `1`.
NEXT_PUBLIC_ARC_ENABLED=
# The routes around Arc that call Circle directly, one direction at a time. Each is a
# comma-separated list or `all`; unset means none. Chains: avalanche, optimism, arbitrum, base,
# polygon, unichain, codex, sonic, worldchain, monad, sei, xdc, hyperevm, ink. SENDS_TO also takes
# `solana`. Switch a direction on once a real transfer has gone through it
# (scripts/test-evm-arc-forwarding-mainnet.sh). These routes have no contract of ours in between.
NEXT_PUBLIC_ARC_SENDS_TO=
NEXT_PUBLIC_ARC_RECEIVES_FROM=
# The EVM chains other than Arc that Stellar may send to through the wrapper: the same chain names,
# or `all`. A chain named here is offered only once the wrapper has its CCTP domain committed (read
# live from the contract), so `all` is safe before any is added. Check a chain first with
# `pnpm check:stellar-evm`.
NEXT_PUBLIC_STELLAR_SENDS_TO=
# `1` sends a transfer out of a chain through Xebra's fee wrapper where one is pinned
# (XEBRA_WRAPPERS in packages/network-config/src/evm-chains.ts), instead of calling Circle directly.
# The address is never read from here. Arc's is pinned (deployed 2026-10-15); see docs/go-live.md.
NEXT_PUBLIC_ARC_USE_WRAPPER=
NEXT_PUBLIC_STELLAR_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_CCTP_WRAPPER_CONTRACT_ID=
NEXT_PUBLIC_API_URL=

# --- Infrastructure (non-secret) --------------------------------------------
# REDIS_URL, KAFKA_BROKERS and DATABASE_URL carry credentials on the self-hosted container path
# and are therefore injected from Secrets Manager, NOT set here.
OTEL_EXPORTER_OTLP_ENDPOINT=
ENVIRONMENT=production
