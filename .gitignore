target/
cache/
artifacts/
broadcast/
out/
contracts/*/lib/

# harness / editor
.claude/

# env
#
# .env.production is NOT committed. It holds only public chain constants, but a .env in a
# repository reads as a mistake regardless of its contents, and the authoritative values live
# in packages/network-config as typed, validated presets anyway.
#
# Copy the example and go:  cp .env.production.example .env.production
.env
.env.local
.env.production
.env.*.local
.env.secrets
.env.*.secret
*.secret.env
!.env.production.example

# soroban
.soroban/
contracts/stellar-soroban/target/
contracts/stellar-soroban/test_snapshots/
contracts/stellar-cctp-wrapper/target/
contracts/stellar-cctp-wrapper/test_snapshots/

# solana
test-ledger/

# e2e demo secrets (generated locally by scripts/e2e-demo/01-solana-setup.ts, never committed)
scripts/e2e-demo/solana-setup.json

# misc
.DS_Store
*.log

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.tfvars
